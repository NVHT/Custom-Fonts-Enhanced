/* ==UserStyle==
@name           Custom Fonts (Enhanced)
@namespace      https://github.com/NVHT/Custom-Fonts-Enhanced
@version        1.0
@description    Apply custom fonts globally while preserving icons and code blocks.
@author         NVHT
@preprocessor   stylus
@license        MIT

@var text     base              "Base font"                    "sans-serif"
@var select   baseStyle         "Base style"                   {"Default*": "null", "Normal": "normal", "Italic": "italic"}
@var select   baseWeight        "Base weight"                  {"Default*": "null", "300": "300", "400": "400", "500": "500", "600": "600", "700": "700"}

@var text     mono              "Mono font"                    "monospace"
@var select   monoWeight        "Mono weight"                  {"Default*": "null", "400": "400", "700": "700"}

@var checkbox smoothing         "Enable font smoothing"        1
@var checkbox enhancer          "Enable super enhancer"        1
@var range    enhanceWeight     "Enhancer boldness (stroke)"   [0.15, 0, 1, 0.05, "px"]
@var range    enhanceShadow     "Enhancer smoothness (shadow)" [0.25, 0, 1, 0.05, "px"]
@var checkbox inputs            "Use Mono in inputs"           0
@var checkbox letterSpacing     "Force 0px spacing"            0
==/UserStyle== */

// --- CATEGORIZED EXCLUSIONS ---

// Iconography (Preserve original fonts)
icons = 'i', 'icon', '.i', '.icon', '[class*=icon]', '[icon]', '[class*=symbol]', '[class*=icofont]', '.fa', '.fab', '.fad', '.fal', '.far', '.fas', '.fa-solid', '.fa-regular', '.fa-light', '.glyphicon', '.ddgsi', '.fancybox-button', '[data-icon-name]', '[class*=tgico-]', '.tgico', 'mjx-math', 'mjx-math *', '.mathjax', '.mathjax *', '[id^=MathJax]', '[class*=MathJax]', '.material-icons', '.material-symbols-outlined', '[class^="ph-"]', '.carbon-icon', '[data-testid="icon"]', '.emoji', '.apple-emoji', 'lt-div', 'lt-div *', '.resource-tile_rating *', '.br-theme-fontawesome-stars *'

// Code & Technical Areas
code = 'code', '.code', 'pre', '.pre', '.monospace', '.text-mono', '.font-mono', '[class*=monospace]', '.ace_editor', '.CodeMirror', '.cm-editor', '.cm-scroller', '.monaco-editor', '.diff-line-num', '.diff-viewer', '.d2h-code-wrapper', '#commandWindowWrapper', '.react-code-lines', '.react-code-text', '.blob-code', '.blob-num'

// Input & Editing Areas
composer = 'textarea', 'input:not([type=button]):not([type=submit]):not([type=reset])', '[contenteditable=true]', '[g_editable]', '#squire', '.QueryBuilder-StyledInputContainer', '[data-slate-editor=true]', '[class*=channelTextArea-]'

// Text to preserve weight
bold = 'strong', 'b', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', '[class*=bold]', '[data-markup*="bold"]'

// --- LOGIC HELPER ---

add_wildcards(list)
    new_list = ()
    for item in list
        append(new_list, item)
        // Add child selector support for non-attribute selectors safely
        // '\\x5b' matches '[' without triggering Stylus parser bugs
        if !match('\\x5b', item)
            append(new_list, item + ' *')
    return new_list

$icons    = join(', ', icons)
$code     = join(', ', add_wildcards(code))
$composer = join(', ', add_wildcards(composer))
$bold     = join(', ', add_wildcards(bold))
$all_excluded = $icons + ', ' + $code + ', ' + $composer + ', body > div'

// --- STYLES ---

@-moz-document regexp('(file|https?|(chrome|moz)-extension)://.+') {

    if smoothing {
        * {
            -webkit-font-smoothing: antialiased !important;
            -moz-osx-font-smoothing: grayscale !important;
        }
    }

    if enhancer {
        * {
            text-rendering: optimizeLegibility !important;
            text-decoration-skip-ink: auto !important;
            font-synthesis: none !important;
        }
        
        // Apply rendering enhancements only to text, carefully excluding icon fonts to avoid bloating/blurring icons
        :not({$icons}) {
            -webkit-text-stroke: enhanceWeight currentColor !important if enhanceWeight != 0px
            text-shadow: 0 0 enhanceShadow currentColor !important if enhanceShadow != 0px
        }
    }

    // Main Font Application
    :not({$all_excluded}) {
        font-family: base !important if base != 'null'
        font-style:  baseStyle !important if baseStyle != 'null'
        letter-spacing: 0px !important if letterSpacing
    }

    // Weight Management (Don't override headers/bold)
    :not({$bold}):not({$icons}) {
        font-weight: baseWeight if baseWeight != 'null'
    }

    // Monospace Overrides
    {$code} {
        font-family: mono !important if mono != 'null'
        font-weight: monoWeight if monoWeight != 'null'
    }

    // Input/Composer Overrides
    {$composer} {
        if inputs {
            font-family: mono !important if mono != 'null'
            font-weight: monoWeight if monoWeight != 'null'
        } else {
            font-family: base !important if base != 'null'
            font-weight: baseWeight if baseWeight != 'null'
        }
    }

}
